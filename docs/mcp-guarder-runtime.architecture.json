  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "客户端请求按 JSON-RPC 行进入网关，只有 tools/list 与 tools/call 被深加工",
        "允许的调用以原始 argv 启动上游子进程，不经过 shell 拼接",
        "回流结果再次脱敏后，才写回协议专用 stdout"
      ]
    },
    {
      "dot": "rose",
      "title": "安全语义",
      "items": [
        "策略无匹配、检测器故障、审计不可用时均采用 fail-closed",
        "Tool 描述、inputSchema 与 annotations 会递归扫描投毒内容",
        "指纹变化保留新快照但不自动信任，用于持续识别 rug pull"
      ]
    },
    {
      "dot": "amber",
      "title": "边界与持久化",
      "items": [
        "上游 MCP Server 位于外部不可信执行域",
        "YAML 配置、SQLite 指纹与本地审计文件构成可信状态",
        "审计只接收已脱敏对象；写盘失败后阻断后续 tools/call"
      ]
    }
  ]
}
